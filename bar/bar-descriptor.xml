<?xml version="1.0" encoding="UTF-8"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>com.compas.probes</id>
    <versionNumber>1.0.0</versionNumber>
    <name>Compas Probes</name>
    <description>On-device compatibility probes for BlackBerry 10</description>
    <author>Compas Project</author>
    <authorId>compas</authorId>
    <copyright>2025 Compas Project</copyright>
    <category>utility.other</category>
    <buildId>1</buildId>
    <configuration>Device-Debug</configuration>
    <icon>
        <image>icon.png</image>
    </icon>
    <action>
        <type>application</type>
        <name>run-probes.sh</name>
        <arg>run-probes.sh</arg>
    </action>
    <env>
        <var name="LD_LIBRARY_PATH">/app/native/probes</var>
    </env>
    <assets>
        <asset path="probes/filesystem_probe">probes/filesystem_probe</asset>
        <asset path="probes/posix_probe">probes/posix_probe</asset>
        <asset path="probes/thread_probe">probes/thread_probe</asset>
        <asset path="probes/loader_probe">probes/loader_probe</asset>
        <asset path="probes/libprobe.so">probes/libprobe.so</asset>
        <asset path="probes/libstdc++.so.6">probes/libstdc++.so.6</asset>
        <asset path="probes/libgcc_s.so.1">probes/libgcc_s.so.1</asset>
        <asset path="run-probes.sh">run-probes.sh</asset>
    </assets>
    <permissions>
        <permission>access_shared</permission>
    </permissions>
</qnx>